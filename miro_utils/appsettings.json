{
  "MiroAutomationParams": {
    "Username": "xx.yy@mycompany.ch",
    "UserPassword": "ChangeMe1234",
    "PlaywrightParams": {
      "Channel": "msedge",
      "Headless": false,
      "BoardLoadTimeoutSeconds": 60 /* How long to wait for a board to load */
    },
    "BackupParams": {
      "Urls": [
        "https://miro.com/app/board/aBdEOTp868Y=/", /* Board A */
        "https://miro.com/app/board/aBdEOTp869Y=/", /* Board B */
        "https://miro.com/app/board/aBdEOTp870Y=/" /* Board C */
      ]
    },
    "ChangePasswordParams": {
      "Urls": [
        "https://miro.com/app/board/aBdEOTp868Y=/", /* Board A */
        "https://miro.com/app/board/aBdEOTp869Y=/", /* Board B */
        "https://miro.com/app/board/aBdEOTp870Y=/" /* Board C */
      ]
    }
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Debug",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}